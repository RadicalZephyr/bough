; FizzBuzz, fed by hand first.
(input in 1)
(tick t 1000)
(def x in)
(defgraph word-for-mod-n [x n word] (if (eq (mod x n) 0) word ""))
(def fizz (word-for-mod-n x 3 "Fizz"))
(def buzz (word-for-mod-n x 5 "Buzz"))
(def words (cat fizz buzz))
(def out (if (eq words "") (str x) words))
(watch out)
(set in 3)
(set in 10)
(set in 30)
; Hand it to the timer.
(def x t)
; Splash on multiples of 7: one more call, and words redefined.
(def splash (word-for-mod-n x 7 "Splash"))
(def words (cat (cat fizz buzz) splash))
(graph)
