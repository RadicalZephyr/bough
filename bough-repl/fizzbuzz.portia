; FizzBuzz, fed by hand first.
(input in 1)
(tick t 1000)
(def x in)
(def fizz (if (eq (mod x 3) 0) "Fizz" ""))
(def buzz (if (eq (mod x 5) 0) "Buzz" ""))
(def words (cat fizz buzz))
(def out (if (eq words "") (str x) words))
(watch out)
(set in 3)
(set in 10)
(set in 30)
; Hand it to the timer.
(def x t)
; Splash on multiples of 7: one binding, and words redefined.
(def splash (if (eq (mod x 7) 0) "Splash" ""))
(def words (cat (cat fizz buzz) splash))
